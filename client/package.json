{
  "name": "aperture-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aperture client workspace \u2014 Vite + React + TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run assert-api-current && npm run assert-sdk-clean && npm run assert-svg-safe && tsc --noEmit && node scripts/adherence-lint.mjs && node scripts/assert-no-bare-strings.mjs && vite build && node scripts/assert-no-external-hosts.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "node scripts/gen-api.mjs",
    "assert-api-current": "node scripts/assert-api-current.mjs",
    "assert-sdk-clean": "node scripts/assert-sdk-clean.mjs",
    "assert-no-external-hosts": "node scripts/assert-no-external-hosts.mjs",
    "assert-svg-safe": "node scripts/assert-svg-safe.mjs",
    "lint:adherence": "node scripts/adherence-lint.mjs",
    "assert-no-bare-strings": "node scripts/assert-no-bare-strings.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss-value-parser": "4.2.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "yaml": "2.8.1"
  }
}

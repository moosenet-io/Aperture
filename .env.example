################################################################################
#  ⚠  NAMES ONLY.  THIS FILE CARRIES NO VALUES, AND MUST NEVER CARRY ONE.      #
################################################################################
#
#  Every assignment below is deliberately EMPTY. This file documents which
#  names Aperture reads; it is not a place to put what they should be set to.
#  A value committed here is a leak in a public mirror, and `npm --prefix
#  client run assert-config-documented` fails the build on any line that
#  assigns one.
#
#  SECRETS ARE NOT IN THIS FILE AT ALL — not even as an empty assignment.
#  They are resolved at runtime from the vault through the secret manager.
#  There is no supported way to supply one here, and writing one into a real
#  `.env` is a review rejection regardless of how carefully it is handled.
#  Their names are listed at the bottom, as comments, so this file remains a
#  complete inventory of the configuration surface without ever offering a
#  slot to fill in.
#
#  Defaults are NOT repeated here. They live in one place —
#  docs/CONFIGURATION.md — and that document is checked against the same
#  manifest this file is, so there is no second copy to drift.
#
#  See:  docs/CONFIGURATION.md            (what each name controls, and its default)
#        contracts/aperture-config-v1.json (the machine-readable key manifest)
#
################################################################################

# ── Feature and access ────────────────────────────────────────────────────────
APERTURE_ENABLED=
APERTURE_ALLOW_SIGNUP=
APERTURE_ADMIN_BOOTSTRAP=

# ── Sessions and devices ──────────────────────────────────────────────────────
APERTURE_SESSION_TTL_SECS=
APERTURE_REFRESH_TTL_SECS=
APERTURE_MAX_DEVICES_PER_USER=
APERTURE_AUTH_RATE_LIMIT_PER_MIN=

# ── Streaming ─────────────────────────────────────────────────────────────────
APERTURE_STREAM_HEARTBEAT_SECS=
APERTURE_STREAM_MAX_IDLE_SECS=
APERTURE_STREAM_RESUME_WINDOW_SECS=
APERTURE_STREAM_MAX_CONCURRENT=
APERTURE_TURN_CANCEL_GRACE_SECS=

# ── Attachments ───────────────────────────────────────────────────────────────
APERTURE_UPLOAD_MAX_BYTES=
APERTURE_UPLOAD_MAX_FILES_PER_THREAD=
APERTURE_UPLOAD_ALLOWED_TYPES=

# ── Modules and context ───────────────────────────────────────────────────────
APERTURE_MODULE_PROBE_TTL_SECS=
APERTURE_CONTEXT_RETENTION_SECS=
APERTURE_CONTEXT_ENABLED=

# ── Secret resolution ─────────────────────────────────────────────────────────
APERTURE_SECRET_CACHE_TTL_SECS=

# ── SECRETS — NAMES ONLY, NEVER VALUES, NEVER AN ASSIGNMENT ───────────────────
#
#  Resolved from the vault at runtime. Do not add an `=` after any of these,
#  here or in a real `.env`. The names are indented under this banner so the
#  documentation gate can inventory them without this file ever offering a
#  slot to fill in.
#
#   APERTURE_SESSION_SIGNING_KEY
#   APERTURE_VAPID_PUBLIC_KEY
#   APERTURE_VAPID_PRIVATE_KEY
